<div class="q-page">
  <QuorumWeb.Shell.header variant={:guest} />

  <div class="q-signin">
    <section class="q-signin-brand">
      <.link href={~p"/"} aria-label="Quorum home"><QuorumWeb.Brand.logo on_dark size={24} /></.link>
      <h2>Open a room and answer the top questions.</h2>
      <p>Open a room and hear what your audience is thinking.</p>
    </section>

    <section class="q-signin-form">
      <div class="q-signin-form-inner">
        <h1>Sign in</h1>
        <p class="q-signin-lead">
          Use your university account, or the access code for this demo.
        </p>

        <button
          type="button"
          class="q-button"
          style="width:100%;"
          disabled="disabled"
        >
          Continue with your university account
        </button>
        <div class="q-or">or</div>

        <form action={~p"/sign-in"} method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <label class="q-label" for="code" style="display:block;margin-bottom:8px;">Access code</label>
          <input
            id="code"
            name="code"
            type="text"
            class="q-input"
            value={@code}
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder={Quorum.Accounts.demo_code()}
          />
          <p :if={@error} class="q-status" style="color:var(--q-destructive);">{@error}</p>
          <button type="submit" class="q-button q-button--secondary" style="margin-top:12px;">
            Enter
          </button>
          <p class="q-meta" style="margin:8px 0 0;">
            Demo access, no email needed. The code is the word shown in the box.
          </p>
        </form>

        <hr class="q-signin-rule" />
        <p class="q-meta" style="margin:0;">
          Students:
          <.link navigate={~p"/join"} class="q-button--link">Join a session with a code</.link>
          instead.
        </p>
      </div>
    </section>
  </div>

  <QuorumWeb.Shell.footer />
</div>
